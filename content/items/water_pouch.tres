[resource]
script = ExtResource("2_item")
id = &"water_pouch"
display_name = "Water Pouch"
description = "A stitched waterskin worn at the hip. Holds 200 water points for waterbending: the Water stance 1 orbit takes 24, each Water Whip 4. Near water you bend the river itself and spend nothing. Fill it at any water with E."
price = 20
max_stack = 1
stats = SubResource("Resource_stats")
growth = SubResource("Resource_growth")
