[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://data/defs/loot_entry.gd" id="1_entry"]
[ext_resource type="Script" path="res://data/defs/loot_table.gd" id="2_table"]
[ext_resource type="Resource" path="res://content/items/sunstone_shard.tres" id="item_sunstone_shard"]

[sub_resource type="Resource" id="Resource_e0"]
script = ExtResource("1_entry")
item = ExtResource("item_sunstone_shard")
chance = 0.5

[sub_resource type="Resource" id="Resource_e1"]
script = ExtResource("1_entry")
item_id = &"gale_scroll"
chance = 0.04

[sub_resource type="Resource" id="Resource_e2"]
script = ExtResource("1_entry")
item_id = &"glacier_scroll"
chance = 0.04

[resource]
script = ExtResource("2_table")
gold_min = 6
gold_max = 14
entries = Array[ExtResource("1_entry")]([SubResource("Resource_e0"), SubResource("Resource_e1"), SubResource("Resource_e2")])
