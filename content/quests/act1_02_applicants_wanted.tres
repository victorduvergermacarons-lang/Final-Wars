[gd_resource type="Resource" script_class="QuestDef" format=3]

[ext_resource type="Script" path="res://data/defs/quest_objective.gd" id="1_obj"]
[ext_resource type="Script" path="res://data/defs/quest_def.gd" id="2_quest"]
[ext_resource type="Script" path="res://data/defs/item_def.gd" id="3_item"]
[ext_resource type="Resource" path="res://content/items/minor_mana_potion.tres" id="item_minor_mana_potion"]

[sub_resource type="Resource" id="Objective_0"]
script = ExtResource("1_obj")
kind = 2
text = "Register with Warden Dorne at the Guild Hall"
npc = &"warden_dorne"

[sub_resource type="Resource" id="Objective_1"]
script = ExtResource("1_obj")
kind = 2
text = "Draw a Guild kit from the quartermaster"
npc = &"guild_quartermaster"

[resource]
script = ExtResource("2_quest")
id = &"act1_02_applicants_wanted"
title = "1-02 Applicants Wanted"
category = 0
area = "The Crossing"
giver = &"maren_voss"
prerequisites = Array[StringName]([&"act1_01_guild_comes_to_millbrook"])
min_level = 2
objectives = Array[ExtResource("1_obj")]([SubResource("Objective_0"), SubResource("Objective_1")])
reward_xp = 150
reward_gold = 20
reward_items = Array[ExtResource("3_item")]([ExtResource("item_minor_mana_potion"), ExtResource("item_minor_mana_potion")])
reward_choice_ids = Array[StringName]([&"spark_scroll", &"river_lash_scroll", &"iron_mallet"])
