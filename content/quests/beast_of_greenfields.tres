[sub_resource type="Resource" id="Resource_7iaoo"]
script = ExtResource("1_rd1rx")
text = "Old Grizzlehide slain"
enemy = &"old_grizzlehide"

[resource]
script = ExtResource("6_fvlaa")
id = &"beast_of_greenfields"
title = "The Beast of Greenfields"
offer_text = "Old Grizzlehide. He roams the fields between the river crossings and nothing alone survives him. Gather friends — at least four — and end him."
progress_text = "Grizzlehide walks a loop through the middle of the fields. Don't fight him alone."
complete_text = "You actually did it. Greenfields is ours again. Take your pick from the armoury — you've earned it."
giver = &"rowan"
prerequisites = Array[StringName]([&"bandit_camp"])
min_level = 3
objectives = Array[ExtResource("1_rd1rx")]([SubResource("Resource_7iaoo")])
reward_xp = 500
reward_gold = 60
reward_choices = Array[ExtResource("2_teooi")]([ExtResource("3_dbbf3"), ExtResource("4_6cmjj"), ExtResource("5_5snu7")])
sets_world_flag = &"grizzlehide_slain"
world_flag_message = "Bells ring in Millbrook: Old Grizzlehide is dead!"
