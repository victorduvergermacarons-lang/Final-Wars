[resource]
script = ExtResource("3_yhdp2")
id = &"bandit_camp"
title = "The Bandit Camp"
offer_text = "Those wolves were fleeing something. Scouts saw bandits camped at the southern end of Greenfields, across the river. Find the camp and break their two brutes."
progress_text = "Cross the bridge near the town road, then head south along the river to the camp. Mind the brutes: slow, but they hit like a falling tree."
complete_text = "Bandits gone, but they'd been hunting a bear — a huge, scarred one. That's worse news than bandits."
giver = &"rowan"
prerequisites = Array[StringName]([&"wolves_at_the_gate"])
min_level = 2
objectives = Array[ExtResource("1_ircbw")]([SubResource("Resource_cau78"), SubResource("Resource_qgldn")])
reward_xp = 220
reward_gold = 30
