[gd_resource type="Resource" script_class="NpcDef" format=3]

[ext_resource type="Script" path="res://data/defs/npc_def.gd" id="1_npc"]
[ext_resource type="Script" path="res://data/defs/item_def.gd" id="2_item"]
[ext_resource type="Resource" path="res://content/items/iron_helm.tres" id="3_helm"]
[ext_resource type="Resource" path="res://content/items/swift_boots.tres" id="4_boots"]
