[ext_resource type="Resource" path="res://content/items/minor_mana_potion.tres" id="6_mp"]

[resource]
script = ExtResource("1_npc")
id = &"guild_quartermaster"
display_name = "Quartermaster Ilse Harrow"
faction = 1
sells = Array[ExtResource("2_item")]([ExtResource("3_helm"), ExtResource("4_boots"), ExtResource("5_hp"), ExtResource("6_mp")])
sells_ids = Array[StringName]([&"ember_fist_scroll", &"cinder_kick_scroll", &"spark_scroll", &"sun_warriors_breath_scroll", &"menders_scroll", &"river_lash_scroll", &"scroll_of_the_current", &"frost_shard_scroll", &"open_palm_scroll", &"breeze_scroll", &"featherstep_scroll", &"pebble_scroll", &"pillar_scroll", &"stomp_scroll", &"rusty_shortsword", &"travelers_longsword", &"hunters_shortbow", &"yew_longbow", &"iron_mallet", &"quarry_maul"])
