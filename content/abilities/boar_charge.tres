[gd_resource type="Resource" script_class="AbilityDef" format=3]

[ext_resource type="Script" path="res://data/defs/hitbox_def.gd" id="hb_script"]
[ext_resource type="Script" path="res://data/defs/ability_effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://data/defs/ability_scaling.gd" id="2_scaling"]
[ext_resource type="Script" path="res://data/defs/ability_def.gd" id="3_ability"]

[sub_resource type="Resource" id="Resource_scale"]
script = ExtResource("2_scaling")

[sub_resource type="Resource" id="Resource_rush"]
script = ExtResource("1_effect")
kind = 13
applies = 1
base_amount = 3.0

[sub_resource type="Resource" id="Resource_hit"]
script = ExtResource("1_effect")
base_amount = 8.0
scaling = Array[ExtResource("2_scaling")]([SubResource("Resource_scale")])

[sub_resource type="Resource" id="Resource_hitbox"]
script = ExtResource("hb_script")
shape = 8
reach = 3.0
min_reach = 2.0
width = 0.9

[resource]
script = ExtResource("3_ability")
id = &"boar_charge"
display_name = "Tusk Charge"
description = "Marks a tile 2-3 tiles away, then rushes there and gores whoever still stands on it."
shape = 1
min_range = 2
max_range = 3
cooldown_seconds = 14.0
max_height_difference = 2
effects = Array[ExtResource("1_effect")]([SubResource("Resource_rush"), SubResource("Resource_hit")])
targeting = 3
windup_seconds = 1.0
hitbox = SubResource("Resource_hitbox")
dodgeable = true
