base_amount = 10.0
scaling = Array[ExtResource("2_sc")]([SubResource("Resource_scale")])

[resource]
script = ExtResource("3_ab")
id = &"water_shield_splash"
display_name = "Water Shield"
description = "A Water Shield bursting: water splashes the enemies around."
max_range = 0
on_gcd = false
requires_line_of_sight = false
effects = Array[ExtResource("1_fx")]([SubResource("Resource_dmg")])
targeting = 1
